---
import type { PostSummary } from "../../lib/posts";
interface Props {
  posts: PostSummary[];
}
const { posts } = Astro.props;
---

<noscript>
  <section class="card page-card" aria-label="所有文章">
    <h2>所有文章</h2>
    <p>启用 JavaScript 后可以搜索、筛选和分页；也可以直接打开以下文章。</p>
    <ul>
      {posts.map((post) => (
        <li>
          <a class="text-link" href={`/posts/${post.id}/`}>
            {post.title}
          </a>
        </li>
      ))}
    </ul>
  </section>
</noscript>
