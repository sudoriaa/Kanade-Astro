---
import PersonalCard from "./PersonalCard.vue";
import { categories, getTags, type PostSummary } from "../../lib/posts";
interface Props { posts: PostSummary[] }
const { posts } = Astro.props;
const tags = getTags(posts);
---
<aside class="left-sidebar" aria-label="个人信息与分类">
  <PersonalCard posts={posts} />
  <section class="card panel category-panel">
    <h2 class="panel-title"><span class="icon-[lucide--folder-open]" aria-hidden="true"></span>文章分类</h2>
    {categories.map((category, index) => <a href={`/posts/?category=${encodeURIComponent(category)}`}><span><span class={["icon-[lucide--code-xml]", "icon-[lucide--notebook-pen]", "icon-[lucide--coffee]"][index]} aria-hidden="true"></span>{category}</span><span class="category-count">{posts.filter(post => post.category === category).length.toString().padStart(2, "0")}</span></a>)}
  </section>
  <section class="card panel" id="tags">
    <h2 class="panel-title"><span class="icon-[lucide--tags]" aria-hidden="true"></span>标签拾光</h2>
    <div class="tag-cloud">{tags.map(tag => <a class="chip" href={`/posts/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</div>
  </section>
  <a class="rss-card card" href="/rss.xml"><span class="icon-[lucide--rss]" aria-hidden="true"></span><div><strong>订阅一点日常</strong><p>通过 RSS，让更新与你相遇</p></div><span class="icon-[lucide--arrow-up-right]" aria-hidden="true"></span></a>
</aside>
<style>
.category-panel > a { display: flex; align-items: center; justify-content: space-between; font-size: 12px; padding: 8px 0; }
.category-panel > a > span:first-child { display: flex; align-items: center; gap: 9px; }
.category-panel > a > span:first-child > span { font-size: 14px; color: var(--muted); }
.category-panel > a:hover { color: var(--accent); padding-left: 4px; }
.category-count { font: 10px "Oxanium-Medium", sans-serif; color: var(--muted); background: var(--bg); padding: 2px 7px; border-radius: 5px; }
.tag-cloud { display: flex; flex-wrap: wrap; gap: 8px 6px; }
.tag-cloud .chip { font-size: 10px; padding: 3px 8px; }
.tag-cloud .chip:nth-child(3n + 2) { color: #789a91; background: #eff6f2; }
.tag-cloud .chip:nth-child(3n + 3) { color: #9184af; background: #f2eff9; }
:global(.dark) .tag-cloud .chip:nth-child(3n + 2) { color: #a9cdbd; background: #2c3e39; }
:global(.dark) .tag-cloud .chip:nth-child(3n + 3) { color: #c0b1e0; background: #363046; }
.rss-card { display: flex; align-items: center; gap: 10px; padding: 18px; color: var(--accent); }
.rss-card > span:first-child { font-size: 22px; }
.rss-card div { flex: 1; }
.rss-card strong { font-weight: 400; font-size: 12px; }
.rss-card p { margin: 4px 0 0; font-size: 9px; color: var(--muted); }
</style>
