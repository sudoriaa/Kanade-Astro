---
import { t, formatDate } from "../../i18n";
import type { PostSummary } from "../../lib/posts";
interface Props {
  posts: PostSummary[];
}
const { posts } = Astro.props;
const months = [...new Set(posts.map((p) => p.date.slice(0, 7)))];
---

<aside class="right-sidebar" aria-label={t("sidebar.activity")}>
  <section class="card panel notice-card">
    <h2 class="panel-title">
      <span class="icon-[lucide--megaphone]" aria-hidden="true"></span>
      {t("sidebar.notice")}
      <span class="notice-dot"></span>
    </h2>
    <p>
      {t("sidebar.noticeGreeting")}
      <span class="accent">✿</span>
    </p>
    <p>{t("sidebar.noticeText")}</p>
    <a href="/about/" class="text-link">
      {t("sidebar.meet")}
      <span class="icon-[lucide--arrow-right]" aria-hidden="true"></span>
    </a>
  </section>
  <section class="card panel recent-panel">
    <h2 class="panel-title">
      <span class="icon-[lucide--clock-3]" aria-hidden="true"></span>
      {t("sidebar.recent")}
    </h2>
    <ol>
      {posts.slice(0, 4).map((post, index) => (
        <li>
          <span class="recent-number">
            {String(index + 1).padStart(2, "0")}
          </span>
          <a href={`/posts/${post.id}/`}>
            <h3>{post.title}</h3>
            <time datetime={post.date}>{formatDate(post.date)}</time>
          </a>
        </li>
      ))}
    </ol>
  </section>
  <section class="card panel archive-panel">
    <h2 class="panel-title">
      <span class="icon-[lucide--calendar-days]" aria-hidden="true"></span>
      {t("sidebar.archive")}
    </h2>
    {months.map((month) => (
      <a href={`/posts/?month=${month}`}>
        <span>
          {formatDate(`${month}-01`, { year: "numeric", month: "long" })}
        </span>
        <span>
          {t("post.records", {
            count: posts.filter((p) => p.date.startsWith(month)).length,
          })}
        </span>
      </a>
    ))}
  </section>
  <section class="card quote-card">
    <span class="quote-mark">“</span>
    <p>{t("sidebar.quote")}</p>
    <span class="quote-source">{t("sidebar.quoteSource")}</span>
    <span class="quote-flower" aria-hidden="true">
      ✿
    </span>
  </section>
  <section class="site-notes">
    <span class="icon-[lucide--sprout]" aria-hidden="true"></span>
    <p>{t("sidebar.growing")}</p>
    <span>{t("sidebar.motto")}</span>
  </section>
</aside>
<style>
  .notice-card {
    background: linear-gradient(135deg, var(--card), var(--accent-soft));
  }
  .notice-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    margin-left: auto;
  }
  .notice-card p {
    font-size: 11px;
    line-height: 2;
    color: var(--muted);
    margin: 8px 0 11px;
  }
  .notice-card p:first-of-type {
    color: var(--text);
  }
  .notice-card .text-link {
    font-size: 11px;
    margin-top: 3px;
  }
  .recent-panel ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .recent-panel li {
    display: flex;
    align-items: start;
    gap: 10px;
    margin-top: 16px;
  }
  .recent-number {
    flex: 0 0 18px;
    white-space: nowrap;
    font:
      13px "Oxanium-Medium",
      var(--font-body);
    color: #d7b1bf;
    line-height: 1.7;
  }
  .recent-panel h3 {
    margin: 0;
    font-size: 11px;
    line-height: 1.8;
    font-weight: 400;
  }
  .recent-panel a:hover h3 {
    color: var(--accent);
  }
  .recent-panel time {
    color: var(--muted);
    font:
      9px "Oxanium-Medium",
      var(--font-body);
  }
  .archive-panel > a {
    display: flex;
    justify-content: space-between;
    margin-top: 14px;
    font-size: 11px;
  }
  .archive-panel > a span:last-child {
    color: var(--muted);
    font-size: 10px;
  }
  .archive-panel > a:hover {
    color: var(--accent);
  }
  .quote-card {
    position: relative;
    overflow: hidden;
    padding: 22px 25px 26px;
    background: linear-gradient(135deg, var(--accent-soft), var(--card));
  }
  .quote-mark {
    font-family: var(--font-body);
    font-size: 50px;
    line-height: 1;
    color: #ddb4c0;
  }
  .quote-card p {
    white-space: pre-line;
    margin: -4px 0 15px;
    font-size: 16px;
    line-height: 2;
    color: var(--accent);
  }
  .quote-source {
    font:
      7px "Oxanium-Medium",
      var(--font-body);
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  .quote-flower {
    position: absolute;
    right: -13px;
    bottom: -42px;
    font-size: 130px;
    color: #e6b4c41a;
    line-height: 1.2;
  }
  .site-notes {
    text-align: center;
    color: var(--muted);
    padding: 2px 0;
  }
  .site-notes > span:first-child {
    font-size: 18px;
    color: #91ae92;
  }
  .site-notes p {
    font-size: 11px;
    margin: 5px 0;
  }
  .site-notes > span:last-child {
    font-size: 9px;
    opacity: 0.7;
  }
</style>
