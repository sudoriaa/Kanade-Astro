{
  "name": "kanade",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro sync && astro check && vue-tsc --noEmit",
    "test": "pnpm build && playwright test",
    "deploy:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/preview.ps1",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.0.3",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.7",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@iconify-json/basil": "^1.2.4",
    "@iconify-json/bx": "^1.2.3",
    "@iconify-json/jam": "^1.2.3",
    "@iconify-json/lucide": "^1.2.141",
    "@iconify-json/material-symbols": "^1.2.94",
    "@iconify-json/mingcute": "^1.2.8",
    "@iconify-json/mynaui": "^1.2.19",
    "@iconify-json/simple-icons": "^1.2.99",
    "@iconify/tailwind4": "^1.2.3",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.33.0 <11"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@tailwindcss/typography>postcss-selector-parser": "^7.1.6"
    }
  }
}
